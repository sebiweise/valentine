// Cloudflare Workers Static Assets for the static export (NEXT_OUTPUT=export pnpm build).
// There is no Worker script: every request is served from out/ without
// invoking a Worker. Deployed by Workers Builds, see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valentine",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./out",
    // /index.html is served as /, other pages without .html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get out/404.html with status 404
    "not_found_handling": "404-page"
  }
}
