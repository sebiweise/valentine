# Next.js output mode: leave empty for the default Next.js server (next start),
# "standalone" for a self-contained Node.js server (Docker) or "export" for a static export
# into out/ (GitHub Pages)
NEXT_OUTPUT=

# Path prefix the app is served under, e.g. /valentine for the GitHub Pages project site.
# Leave empty to serve the app at the root of the domain.
BASE_PATH=
